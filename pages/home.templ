package pages

templ Home() {
	@layout(metadata{
		Title: "Erik Jermaniš | Software i automatizacija za poduzetnike",
		Description: "Prilagođene aplikacije, procesi i alati za male i srednje poduzetnike. Pomažem vam automatizirati repetitivne djelove posla kako biste se mogli fokusirati na ono što je važno.",
		Canonical: "https://eriksoftware.hr/",
	}) {
		<section class="hero" aria-labelledby="home-title">
			<div class="wrap hero-grid">
				<div class="hero-copy">
					<span class="eyebrow">Erik Jermaniš</span>
					<h1 id="home-title">Software i automatizacija za male i srednje poduzetnike</h1>
					<p class="hero-lead">Pomažem Vam efikasnije raditi svoj posao izradom prilagođenih aplikacija, procesa i alata.</p>
					<p>Rješenja koja radim u potpunosti su prilagođena Vama i Vašem poslovanju, stoga nije potrebno trošiti vrijeme na prilagodbu i učenje još jednog alata, već su rezultati jasno vidljivi od prvog dana.</p>
				</div>
				<aside class="hero-card" aria-label="Moj pristup">
					<span class="mono">Moj pristup / 01</span>
					<strong>Jednostavna rješenja.<br/>Konkretni rezultati.</strong>
					<p>Čvrsto vjerujem da se jednostavnim rješenjima mogu postići veliki rezultati. Gradim efikasan software bez nepotrebnih komplikacija.</p>
				</aside>
			</div>
		</section>

		<section class="section process-section" id="kako-radim" aria-labelledby="process-title">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">01 / Proces</span>
					<div>
						<h2 id="process-title">Kako radim?</h2>
						<p>Prva dva koraka nikada ne naplaćujem. Plaćate ono što će Vam stvarno pomoći i donjeti mjerljive rezultate.</p>
					</div>
				</div>
				<ol class="process-list">
					<li class="process-step">
						<span class="step-number">01</span>
						<h3>Otkrivanje potrebe</h3>
						<p>Razgovaramo o Vašem poslovanju, te zajedno identificiramo što se može automatizirati</p>
					</li>
					<li class="process-step">
						<span class="step-number">02</span>
						<h3>Predstavljanje idejnog rješenja</h3>
						<p>Na temelju prethodno otkrivenih potreba, skiciram idejno rješenje i pokazujem Vam konkretno kakve će rezultate nositi. Tek kada ste očarani rezultatom idemo na idući korak.</p>
					</li>
					<li class="process-step">
						<span class="step-number">03</span>
						<h3>Izrada</h3>
						<p>Rješenje gradim koristeći AI, no vodim se strogim standardima sigurnosti i kvalitete. Dugogodišnje iskustvo inženjera softvera mi pomaže da dostavljam sigurne, kvalitetne i održive alate.</p>
					</li>
					<li class="process-step">
						<span class="step-number">04</span>
						<h3>Puštanje u rad</h3>
						<p>U najkraćem mogućem roku dostavljam gotovo rješenje kojeg počinjete koristiti odmah jer je napravljeno u potpunosti po Vašoj mjeri, stoga učenje i prilagodba nisu potrebni.</p>
					</li>
				</ol>
			</div>
		</section>

		<section class="section consulting-section" id="konzultacije" aria-labelledby="consulting-title">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">02 / Konzultacije</span>
					<div>
						<h2 id="consulting-title">Koristite AI za samostalan razvoj softwarea i trebate pomoć?</h2>
						<p>AI alati su postali nezamislivo napredni, i zbilja je istina da "danas svatko može programirati". Nemam ništa protiv da ljudi izrađuju svoj software sami, štoviše podržavam to. Ako negdje u tom procesu osjećate da trebate pomoć, savjet ili provjeru sigurnosti Vaše kreacije, uvijek sam spreman pomoći.</p>
					</div>
				</div>
				<div class="card-grid">
					<article class="consulting-card">
						<span class="mono">01 / Podrška pri razvoju</span>
						<h3>Nauči koristiti AI.</h3>
						<p>Ako već radite, ili želite početi raditi svoje alate koristeći AI ali osjećate se izgubljeno u određenim koracima, tu sam da Vam pomognem. Cilj mi je zbilja pomoći. Ako netko želi sam razvijati software pružiti ću pomoć i podršku, a neću umjesto toga prodavati svoja rješenja.</p>
					</article>
					<article class="consulting-card">
						<span class="mono">02 / Nastavak razvoja</span>
						<h3>Manjak vremena?</h3>
						<p>Već ste izgradili ozbiljna rješenja koja koristite i štede Vam vrijeme, ali nemate vremena za daljnji razvoj, održavanje ili hosting. Nema problema, ja preuzimam gdje ste stali i dodajem ono što fali. Pružam usluge održavanja i hostinga za Vaše ideje i postojeće aplikacije.</p>
					</article>
				</div>
			</div>
		</section>
	}
}
