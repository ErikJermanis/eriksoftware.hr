package pages

templ Home() {
	@layout(metadata{
		Title: "Erik Jermaniš | Software i automatizacija za poduzetnike",
		Description: "Prilagođene aplikacije, procesi i alati za male i srednje poduzetnike. Pomažem vam automatizirati repetitivne djelove posla kako biste se mogli fokusirati na ono što je važno.",
		Canonical: "https://eriksoftware.hr/",
	}) {
		<section class="hero" aria-labelledby="home-title">
			<div class="wrap">
				<div class="hero-grid">
					<div class="hero-copy">
						<span class="eyebrow">Erik Jermaniš</span>
						<h1 id="home-title">Software i automatizacija za male i srednje poduzetnike</h1>
						<p class="hero-lead">Pomažem Vam efikasnije raditi svoj posao izradom prilagođenih aplikacija, procesa i alata.</p>
						<p>Rješenja koja radim u potpunosti su prilagođena Vama i Vašem poslovanju, stoga nije potrebno trošiti vrijeme na prilagodbu i učenje još jednog alata, već su rezultati jasno vidljivi od prvog dana.</p>
					</div>
					<aside class="hero-card" aria-label="Moj pristup">
						<span class="mono">Moj pristup</span>
						<strong>Jednostavna rješenja.<br/>Konkretni rezultati.</strong>
						<p>Čvrsto vjerujem da se jednostavnim rješenjima mogu postići veliki rezultati. Gradim efikasan software bez nepotrebnih komplikacija.</p>
					</aside>
				</div>
				<div class="signal-strip" aria-label="Usluge">
					<article class="signal">
						<h2 class="mono">In-house alati</h2>
						<p>Gradim alate koji se integriraju u Vaše poslovanje i rade s Vašim postojećim softwareom.</p>
					</article>
					<article class="signal">
						<h2 class="mono">Automatizacija</h2>
						<p>Automatiziram poslovne procese softwareom uz vidljive rezultate i uštedu vremena.</p>
					</article>
					<article class="signal">
						<h2 class="mono">Web rješenja</h2>
						<p>Izrađujem prilagođen software i web sustave, te nudim hosting i održavanje.</p>
					</article>
				</div>
			</div>
		</section>

		<section class="section process-section" id="kako-radim" aria-labelledby="process-title">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Proces</span>
					<div>
						<h2 id="process-title">Kako radim?</h2>
						<p>Četiri koraka, od prvog razgovora do alata koji koristite svaki dan.</p>
					</div>
				</div>
				<div class="story">
					<div class="story-tabs" role="tablist" aria-label="Koraci procesa">
						<button class="story-tab" type="button" role="tab" id="story-tab-1" aria-controls="story-panel-1" aria-selected="true">
							<span class="step-number">01</span><span class="story-tab-title">Otkrivanje potrebe</span><span class="story-bar"><i></i></span>
						</button>
						<button class="story-tab" type="button" role="tab" id="story-tab-2" aria-controls="story-panel-2" aria-selected="false" tabindex="-1">
							<span class="step-number">02</span><span class="story-tab-title">Idejno rješenje</span><span class="story-bar"><i></i></span>
						</button>
						<button class="story-tab" type="button" role="tab" id="story-tab-3" aria-controls="story-panel-3" aria-selected="false" tabindex="-1">
							<span class="step-number">03</span><span class="story-tab-title">Izrada</span><span class="story-bar"><i></i></span>
						</button>
						<button class="story-tab" type="button" role="tab" id="story-tab-4" aria-controls="story-panel-4" aria-selected="false" tabindex="-1">
							<span class="step-number">04</span><span class="story-tab-title">Puštanje u rad</span><span class="story-bar"><i></i></span>
						</button>
					</div>
					<div class="story-stage">
						<div class="story-panels">
							<div class="story-panel is-active" role="tabpanel" id="story-panel-1" aria-labelledby="story-tab-1">
								<div class="story-visual" aria-hidden="true">
									<div class="mock">
										<div class="mock-head"><span>Bilješke s razgovora</span><i></i></div>
										<ul class="mock-list">
											<li><span>Ručni unos narudžbi</span><b class="mock-tag mock-tag--blue">automatizirati</b></li>
											<li><span>Ponude i podsjetnici</span><b class="mock-tag mock-tag--blue">automatizirati</b></li>
											<li><span>Razgovor s kupcima</span><b class="mock-tag">ostaje Vama</b></li>
										</ul>
									</div>
								</div>
								<div class="story-copy">
									<span class="story-tag">Razgovaramo.</span>
									<h3>Otkrivanje potrebe</h3>
									<p>Razgovaramo o Vašem poslovanju i zajedno identificiramo što se može automatizirati.</p>
								</div>
							</div>
							<div class="story-panel" role="tabpanel" id="story-panel-2" aria-labelledby="story-tab-2">
								<div class="story-visual" aria-hidden="true">
									<div class="mock mock--sketch">
										<div class="mock-head"><span>Idejno rješenje · skica</span><i></i></div>
										<div class="mock-body">
											<p class="mock-label">Vrijeme na ručni posao</p>
											<div class="mock-bar"><span>Prije</span><i style="--w: 100%"></i></div>
											<div class="mock-bar"><span>Poslije</span><i class="is-blue" style="--w: 24%"></i></div>
										</div>
										<span class="mock-stamp">Idemo dalje ✓</span>
									</div>
								</div>
								<div class="story-copy">
									<span class="story-tag">Skiciram.</span>
									<h3>Idejno rješenje</h3>
									<p>Skiciram rješenje i konkretno Vam pokazujem kakve će rezultate donijeti. Dalje idemo tek kada ste zadovoljni, a ako nema prostora za poboljšanje, tu stajemo.</p>
								</div>
							</div>
							<div class="story-panel" role="tabpanel" id="story-panel-3" aria-labelledby="story-tab-3">
								<div class="story-visual" aria-hidden="true">
									<div class="mock mock--term">
										<div class="mock-head"><span>Izrada</span><i></i></div>
										<ol class="mock-term">
											<li>› gradim uz AI</li>
											<li><b>✓</b> sigurnost</li>
											<li><b>✓</b> kvaliteta</li>
											<li><b>✓</b> održivost</li>
										</ol>
									</div>
								</div>
								<div class="story-copy">
									<span class="story-tag story-tag--build">Gradim.</span>
									<h3>Izrada</h3>
									<p>Rješenje gradim koristeći AI, uz stroge standarde sigurnosti i kvalitete. Dugogodišnje iskustvo softverskog inženjera pomaže mi graditi sigurne i održive alate.</p>
								</div>
							</div>
							<div class="story-panel" role="tabpanel" id="story-panel-4" aria-labelledby="story-tab-4">
								<div class="story-visual" aria-hidden="true">
									<div class="mock mock--live">
										<div class="mock-toast">
											<span class="mock-check">✓</span>
											<div><strong>Rješenje je pušteno u rad</strong><span>Spremno za korištenje</span></div>
										</div>
										<dl class="mock-stats">
											<div><dt>Učenje</dt><dd>0 h</dd></div>
											<div><dt>Prilagodba</dt><dd>0 h</dd></div>
										</dl>
									</div>
								</div>
								<div class="story-copy">
									<span class="story-tag story-tag--build">Koristite.</span>
									<h3>Puštanje u rad</h3>
									<p>U najkraćem mogućem roku dostavljam gotovo rješenje. Napravljeno je po Vašoj mjeri, pa ga koristite odmah, bez učenja i prilagodbe.</p>
								</div>
							</div>
						</div>
						<div class="story-nav">
							<span class="story-count"><b>01</b> / 04</span>
							<button class="story-btn" type="button" data-dir="-1" aria-label="Prethodni korak">←</button>
							<button class="story-btn" type="button" data-dir="1" aria-label="Sljedeći korak">→</button>
						</div>
					</div>
				</div>
			</div>
		</section>
		<script>
			(() => {
				const story = document.querySelector(".story");
				const tabs = [...story.querySelectorAll(".story-tab")];
				const panels = [...story.querySelectorAll(".story-panel")];
				const count = story.querySelector(".story-count b");
				const stage = story.querySelector(".story-stage");
				const compact = matchMedia("(max-width: 960px)");
				let index = 0;
				let autoplay = !matchMedia("(prefers-reduced-motion: reduce)").matches;

				const show = (i) => {
					index = (i + tabs.length) % tabs.length;
					tabs.forEach((tab, n) => {
						const on = n === index;
						tab.setAttribute("aria-selected", String(on));
						tab.tabIndex = on ? 0 : -1;
						tab.classList.toggle("is-done", n < index);
						panels[n].classList.toggle("is-active", on);
					});
					count.textContent = String(index + 1).padStart(2, "0");
				};

				// Any manual navigation ends autoplay for good.
				const takeOver = (i) => {
					autoplay = false;
					story.classList.remove("is-playing");
					show(i);
				};

				tabs.forEach((tab, n) => {
					tab.addEventListener("click", () => takeOver(n));
					tab.addEventListener("keydown", (event) => {
						const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
						if (!step) return;
						event.preventDefault();
						takeOver(index + step);
						tabs[index].focus();
					});
					tab.querySelector(".story-bar i").addEventListener("animationend", () => {
						if (!autoplay) return;
						if (index === tabs.length - 1) {
							autoplay = false;
							story.classList.remove("is-playing");
							return;
						}
						show(index + 1);
					});
				});

				story.querySelectorAll(".story-btn").forEach((button) =>
					button.addEventListener("click", (event) => {
						event.stopPropagation();
						takeOver(index + Number(button.dataset.dir));
					})
				);

				// Stories-style taps on phones: left third goes back, the rest forward.
				stage.addEventListener("click", (event) => {
					if (!compact.matches || event.target.closest("button, a")) return;
					const box = stage.getBoundingClientRect();
					takeOver(index + (event.clientX - box.left < box.width / 3 ? -1 : 1));
				});

				// Pause while hovered, pressed or focused, and while off-screen.
				const pause = (on) => story.classList.toggle("is-paused", on);
				story.addEventListener("mouseenter", () => pause(true));
				story.addEventListener("mouseleave", () => pause(false));
				stage.addEventListener("pointerdown", (event) => event.pointerType !== "mouse" && pause(true));
				stage.addEventListener("pointerup", () => pause(false));
				stage.addEventListener("pointercancel", () => pause(false));
				story.addEventListener("focusin", () => pause(true));
				story.addEventListener("focusout", () => pause(false));

				if ("IntersectionObserver" in window) {
					const observer = new IntersectionObserver(([entry]) => {
						if (entry.isIntersecting && autoplay) story.classList.add("is-playing");
						if (!entry.isIntersecting) pause(true);
						else if (!story.matches(":hover")) pause(false);
						// Replay the first mock once the card first comes into view.
						if (entry.isIntersecting && !story.dataset.seen) {
							story.dataset.seen = "1";
							panels[index].classList.remove("is-active");
							void panels[index].offsetWidth;
							panels[index].classList.add("is-active");
						}
					}, { threshold: 0.5 });
					observer.observe(story);
				}

				show(0);
			})();
		</script>

		<section class="section consulting-section" id="konzultacije" aria-labelledby="consulting-title">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">Konzultacije</span>
					<div>
						<h2 id="consulting-title">Gradite vlastiti software uz&nbsp;AI?</h2>
						<p>Podržavam to, danas zbilja svatko može graditi vlastiti software. Pružam podršku i savjetovanje kako bi Vaš proizvod bio kvalitetan alat te štitim Vaše poslovanje od gubitka podataka ili drugih sigurnosnih rizika.</p>
					</div>
				</div>
				<div class="mirror">
					<div class="mirror-pick">
						<p class="mirror-q mono" id="mirror-q">Prepoznajete li se?</p>
						<div class="mirror-list" role="radiogroup" aria-labelledby="mirror-q">
							<button class="mirror-opt" type="button" role="radio" aria-checked="true" aria-controls="mirror-a-1"><span>„AI se vrti u krug.”</span></button>
							<button class="mirror-opt" type="button" role="radio" aria-checked="false" aria-controls="mirror-a-2" tabindex="-1"><span>„Ne znam odakle početi.”</span></button>
							<button class="mirror-opt" type="button" role="radio" aria-checked="false" aria-controls="mirror-a-3" tabindex="-1"><span>„Je li ovo sigurno?”</span></button>
							<button class="mirror-opt" type="button" role="radio" aria-checked="false" aria-controls="mirror-a-4" tabindex="-1"><span>„Kako ovo staviti online?”</span></button>
							<button class="mirror-opt" type="button" role="radio" aria-checked="false" aria-controls="mirror-a-5" tabindex="-1"><span>„Nemam vremena za dalje.”</span></button>
						</div>
					</div>
					<div class="mirror-answers" aria-live="polite">
						<div class="mirror-a is-active" id="mirror-a-1">
							<img src="/assets/profil_web.jpg" width="56" height="56" alt="" loading="lazy"/>
							<div>
								<p class="mirror-quote">„AI se vrti u krug.”</p>
								<p class="mirror-reply">Nađemo grešku zajedno.</p>
								<p class="mirror-detail">I pokažem Vam kako je sljedeći put riješiti sami.</p>
								<span class="mirror-tag">Podrška pri razvoju</span>
							</div>
						</div>
						<div class="mirror-a" id="mirror-a-2">
							<img src="/assets/profil_web.jpg" width="56" height="56" alt="" loading="lazy"/>
							<div>
								<p class="mirror-quote">„Ne znam odakle početi.”</p>
								<p class="mirror-reply">Krenimo od prvog koraka.</p>
								<p class="mirror-detail">Pomažem Vam odabrati alate i složiti plan, bez nametanja svojih rješenja.</p>
								<span class="mirror-tag">Podrška pri razvoju</span>
							</div>
						</div>
						<div class="mirror-a" id="mirror-a-3">
							<img src="/assets/profil_web.jpg" width="56" height="56" alt="" loading="lazy"/>
							<div>
								<p class="mirror-quote">„Je li ovo sigurno?”</p>
								<p class="mirror-reply">Pregledam aplikaciju prije nego što je pustite u rad.</p>
								<p class="mirror-detail">I jasno Vam kažem što je u redu, a što treba popraviti.</p>
								<span class="mirror-tag">Provjera sigurnosti</span>
							</div>
						</div>
						<div class="mirror-a" id="mirror-a-4">
							<img src="/assets/profil_web.jpg" width="56" height="56" alt="" loading="lazy"/>
							<div>
								<p class="mirror-quote">„Kako ovo staviti online?”</p>
								<p class="mirror-reply">Online, sigurno i s kopijama.</p>
								<p class="mirror-detail">Pomažem Vam postaviti aplikaciju ili je hostam umjesto Vas.</p>
								<span class="mirror-tag">Nastavak razvoja</span>
							</div>
						</div>
						<div class="mirror-a" id="mirror-a-5">
							<img src="/assets/profil_web.jpg" width="56" height="56" alt="" loading="lazy"/>
							<div>
								<p class="mirror-quote">„Nemam vremena za dalje.”</p>
								<p class="mirror-reply">Preuzimam tamo gdje ste stali.</p>
								<p class="mirror-detail">Dodajem što fali, održavam i hostam. Vi se bavite poslom.</p>
								<span class="mirror-tag">Nastavak razvoja</span>
							</div>
						</div>
						<span class="mirror-timer" aria-hidden="true"><i></i></span>
					</div>
				</div>
				<div class="consulting-cta">
					<a href="mailto:erik@eriksoftware.hr?subject=Konzultacije">Pišite mi →</a>
					<span>erik@eriksoftware.hr</span>
				</div>
			</div>
		</section>
		<script>
			(() => {
				const root = document.querySelector(".mirror");
				const opts = [...root.querySelectorAll(".mirror-opt")];
				const answers = [...root.querySelectorAll(".mirror-a")];
				const timer = root.querySelector(".mirror-timer i");
				let index = 0;
				let autoplay = !matchMedia("(prefers-reduced-motion: reduce)").matches;

				const show = (i) => {
					index = (i + opts.length) % opts.length;
					opts.forEach((opt, n) => {
						const on = n === index;
						opt.setAttribute("aria-checked", String(on));
						opt.tabIndex = on ? 0 : -1;
						answers[n].classList.toggle("is-active", on);
					});
					// Restart the countdown bar.
					timer.style.animation = "none";
					void timer.offsetWidth;
					timer.style.animation = "";
				};

				// Any manual choice ends the auto-cycle for good.
				const takeOver = (i) => {
					autoplay = false;
					root.classList.remove("is-playing");
					show(i);
				};

				opts.forEach((opt, n) => {
					opt.addEventListener("click", () => takeOver(n));
					opt.addEventListener("keydown", (event) => {
						const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[event.key];
						if (!step) return;
						event.preventDefault();
						takeOver(index + step);
						opts[index].focus();
					});
				});

				timer.addEventListener("animationend", () => {
					if (!autoplay) return;
					if (index === opts.length - 1) {
						autoplay = false;
						root.classList.remove("is-playing");
						return;
					}
					show(index + 1);
				});

				// Pause while hovered or focused, and while off-screen.
				const pause = (on) => root.classList.toggle("is-paused", on);
				root.addEventListener("mouseenter", () => pause(true));
				root.addEventListener("mouseleave", () => pause(false));
				root.addEventListener("focusin", () => pause(true));
				root.addEventListener("focusout", () => pause(false));

				if ("IntersectionObserver" in window) {
					new IntersectionObserver(([entry]) => {
						if (entry.isIntersecting && autoplay) root.classList.add("is-playing");
						if (!entry.isIntersecting) pause(true);
						else if (!root.matches(":hover")) pause(false);
					}, { threshold: 0.5 }).observe(root);
				}

				show(0);
			})();
		</script>

		<section class="section about-section" id="o-meni" aria-labelledby="about-title">
			<div class="wrap">
				<div class="section-head">
					<span class="eyebrow">O meni</span>
					<div>
						<h2 id="about-title">Tko sam ja?</h2>
						<div class="about-detail">
							<img src="/assets/profil_web.jpg" width="165" height="165" alt="Erik Jermaniš" loading="lazy"/>
							<div class="about-copy">
								<p>Ja sam Erik, softverski inženjer iz Rijeke. Izradom softwarea bavim se preko 7 godina, te sam kroz karijeru imao prilike raditi na velikim projektima i platformama koje koriste stotine tisuća korisnika diljem svijeta.</p>
								<p>Gradim kvalitetan, jednostavan i siguran software koji donosi konkretne rezultate, te pomažem poduzetnicima da efektivno i na siguran način koriste AI alate.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	}
}
